# Crypto Listing Monitor PRO - API Keys Configuration
# ===================================================
# Copy this file to .env and add your API keys

# CoinMarketCap Pro API Key
# Get yours at: https://coinmarketcap.com/api/
# Free tier: 333 credits/day (sufficient for ~1-2 runs per day)
CMC_API_KEY=your_coinmarketcap_api_key_here

# CoinGecko API Key (optional but recommended)
# Get yours at: https://www.coingecko.com/en/api/pricing
# Free tier: 10-50 calls/minute
COINGECKO_API_KEY=your_coingecko_api_key_here

# Note: DexScreener doesn't require an API key for public endpoints
